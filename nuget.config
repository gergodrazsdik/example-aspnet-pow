<?xml version="1.0" encoding="utf-8"?>
<!-- Only nuget.org. minPublishAgeHours (.NET 11 SDK): `dotnet package add` and `update` skip
  versions published less than 14 days ago; the exact versions in Directory.Packages.props
  restore regardless. -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" minPublishAgeHours="336" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
