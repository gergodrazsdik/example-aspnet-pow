<Project>
  <!-- Central package management: versions here, PackageReference without Version in the projects. -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <!-- Browser tests and screenshots: TUnit with Playwright. -->
    <PackageVersion Include="TUnit.Playwright" Version="1.83.0" />
    <!-- Unit and endpoint tests (TUnit.AspNetCore brings TUnit and Microsoft.AspNetCore.Mvc.Testing). -->
    <PackageVersion Include="TUnit.AspNetCore" Version="1.83.0" />
  </ItemGroup>
</Project>
